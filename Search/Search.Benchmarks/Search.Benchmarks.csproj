<Project Sdk="Microsoft.NET.Sdk">
  <!-- Standalone console benchmark app — NOT part of Musify.sln -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="NBomber" Version="6.3.0" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
  </ItemGroup>

  <!-- Variant projects are one level up in backend/Search/ -->
  <ItemGroup>
    <ProjectReference Include="..\Search.Abstractions\Search.Abstractions.csproj" />
    <ProjectReference Include="..\Search.Variant1.Pagination\Search.Variant1.Pagination.csproj" />
    <ProjectReference Include="..\Search.Variant2_1.LevenshteinBasic\Search.Variant2_1.LevenshteinBasic.csproj" />
    <ProjectReference Include="..\Search.Variant2_2.LevenshteinStack\Search.Variant2_2.LevenshteinStack.csproj" />
    <ProjectReference Include="..\Search.Variant3_1.DamerauBasic\Search.Variant3_1.DamerauBasic.csproj" />
    <ProjectReference Include="..\Search.Variant3_2.DamerauStack\Search.Variant3_2.DamerauStack.csproj" />
    <ProjectReference Include="..\Search.Variant3_3.DamerauBitmap\Search.Variant3_3.DamerauBitmap.csproj" />
    <ProjectReference Include="..\Search.Variant4_1.FstAutomaton\Search.Variant4_1.FstAutomaton.csproj" />
    <ProjectReference Include="..\Search.Variant4_2.FstAutomaton\Search.Variant4_2.FstAutomaton.csproj" />
  </ItemGroup>
</Project>
